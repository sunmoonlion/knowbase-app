{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowledge/retrieval/v1/knowledge-retrieval-response.schema.json",
  "title": "Knowledge retrieval response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "retrieval_id",
    "request_id",
    "evidence",
    "total_candidates",
    "truncated"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "retrieval_id": { "$ref": "#/$defs/uuid" },
    "request_id": { "$ref": "#/$defs/uuid" },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "total_candidates": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "nullableUri": {
      "type": ["string", "null"],
      "format": "uri",
      "maxLength": 8192,
      "pattern": "^https?://"
    },
    "providerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "const": "ragflow" },
        "term_similarity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "vector_similarity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "knowledge_document_id",
        "knowledge_document_version_id",
        "chunk_id",
        "content",
        "score",
        "rank",
        "title",
        "source_uri",
        "source_app",
        "source_document_id",
        "source_document_version_id",
        "content_hash",
        "token_estimate",
        "truncated",
        "access_scope",
        "provider_metadata"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/uuid" },
        "knowledge_document_id": { "$ref": "#/$defs/uuid" },
        "knowledge_document_version_id": { "$ref": "#/$defs/uuid" },
        "chunk_id": { "$ref": "#/$defs/uuid" },
        "content": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rank": { "type": "integer", "minimum": 1, "maximum": 50 },
        "title": { "type": ["string", "null"], "maxLength": 4096 },
        "source_uri": { "$ref": "#/$defs/nullableUri" },
        "source_app": { "const": "knowfeed-app" },
        "source_document_id": { "$ref": "#/$defs/uuid" },
        "source_document_version_id": { "$ref": "#/$defs/uuid" },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "token_estimate": { "type": "integer", "minimum": 1 },
        "truncated": { "type": "boolean" },
        "access_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "provider_metadata": { "$ref": "#/$defs/providerMetadata" }
      }
    }
  }
}
