{
  "$defs": {
    "DataRequest": {
      "additionalProperties": false,
      "description": "一样数据：主体（证券代码、机构编号；空是不限主体）、类型（细类，或只写大类）、\n期间规则、版本形态、格式、份数、是不是必需、要的读法、来源限制、多候选时的优先\n策略、表格类的表与列；事项与行业写了就是缩小范围；名字、说明（为什么要）、口径\n只展示。",
      "properties": {
        "caliber": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caliber"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "doc_type": {
          "enum": [
            "disclosure",
            "research",
            "news",
            "briefing",
            "policy",
            "statistics",
            "other",
            "annual_report",
            "semiannual_report",
            "q1_report",
            "q3_report",
            "interim_announcement",
            "prospectus",
            "listing_announcement",
            "ir_activity",
            "ir_qa",
            "research_morning",
            "research_macro",
            "research_strategy",
            "research_industry",
            "research_company",
            "research_quant",
            "research_market",
            "research_fixed_income",
            "research_commodity",
            "research_derivatives",
            "research_fund",
            "research_fx",
            "research_reits",
            "research_esg",
            "research_other",
            "financial_news",
            "recommended_news",
            "negative_news",
            "brief",
            "law",
            "administrative_regulation",
            "departmental_rule",
            "normative_document",
            "local_regulation",
            "judicial_interpretation",
            "policy_interpretation",
            "business_rule",
            "regulatory_letter",
            "statistical_bulletin",
            "statistical_data",
            "census",
            "webpage",
            "other_table",
            "other_text"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "edition": {
          "default": "full",
          "enum": [
            "full",
            "summary",
            "english"
          ],
          "title": "Edition",
          "type": "string"
        },
        "formats": {
          "items": {
            "enum": [
              "pdf",
              "excel",
              "csv",
              "text",
              "markdown",
              "html"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "industry": {
          "anyOf": [
            {
              "enum": [
                "石油石化",
                "煤炭",
                "有色金属",
                "电力及公用事业",
                "钢铁",
                "基础化工",
                "建筑",
                "建材",
                "轻工制造",
                "机械",
                "电力设备",
                "国防军工",
                "汽车",
                "商贸零售",
                "消费者服务",
                "家电",
                "纺织服装",
                "医药",
                "食品饮料",
                "农林牧渔",
                "银行",
                "非银行金融",
                "房地产",
                "交通运输",
                "电子元器件",
                "通信",
                "计算机",
                "传媒",
                "综合"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Industry"
        },
        "key": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "max_count": {
          "default": 1,
          "maximum": 200,
          "minimum": 1,
          "title": "Max Count",
          "type": "integer"
        },
        "min_count": {
          "default": 1,
          "maximum": 200,
          "minimum": 1,
          "title": "Min Count",
          "type": "integer"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/PeriodRule"
        },
        "priority": {
          "anyOf": [
            {
              "enum": [
                "public_first",
                "upload_first",
                "newest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Priority"
        },
        "reading": {
          "default": "original",
          "enum": [
            "original",
            "text",
            "pages",
            "table"
          ],
          "title": "Reading",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "sources": {
          "default": [],
          "items": {
            "enum": [
              "disclosure",
              "collected",
              "upload",
              "output"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Sources",
          "type": "array"
        },
        "subject": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "tables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DataTable"
          },
          "maxItems": 20,
          "title": "Tables",
          "type": "array"
        },
        "topics": {
          "default": [],
          "items": {
            "enum": [
              "results",
              "ipo",
              "refinancing",
              "dividend",
              "meetings",
              "governance",
              "operations",
              "restructuring",
              "equity",
              "trading",
              "intermediary",
              "supervision"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "key",
        "name",
        "doc_type",
        "period",
        "formats"
      ],
      "title": "DataRequest",
      "type": "object"
    },
    "DataTable": {
      "additionalProperties": false,
      "description": "表格类数据要有的一张表与几列（按表头的字认，不按位置）；CSV 不写表名。",
      "properties": {
        "columns": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "sheet": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        }
      },
      "required": [
        "columns"
      ],
      "title": "DataTable",
      "type": "object"
    },
    "PeriodRule": {
      "additionalProperties": false,
      "description": "固定期间（start、end）；定期报告最近 N 个完整的报告期（latest + count，\n可加截至任务日期已披露）；其余类型最近 N 个月内披露的（recent + months），\n或不限期间（none）。定期报告的期间是报告期，其余类型的期间是披露时间窗\n（SDD 0049）。",
      "properties": {
        "count": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "disclosed_by_task_date": {
          "default": false,
          "title": "Disclosed By Task Date",
          "type": "boolean"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "kind": {
          "enum": [
            "fixed",
            "latest",
            "recent",
            "none"
          ],
          "title": "Kind",
          "type": "string"
        },
        "months": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Months"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PeriodRule",
      "type": "object"
    }
  },
  "$id": "https://contracts.sunmoonai.com/knowbase/data-request/v1/data-request.schema.json",
  "$ref": "#/$defs/DataRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data request v1"
}
