    "GrantItemIn": {
      "additionalProperties": false,
      "description": "申请的一项：钉哪一版（与读法）、凭什么依据。\n\n依据：`display` + `app:<应用>`（展示给执行的应用）、`frozen_binding` +\n`expert:<专家>@<版本>`（作者交付时冻结的绑定）、`platform` +\n`platform:<应用>:<过程>:<编号>`（平台过程）。",
      "properties": {
        "basis": {
          "enum": [
            "display",
            "frozen_binding",
            "platform",
            "processing",
            "reference"
          ],
          "title": "Basis",
          "type": "string"
        },
        "basis_ref": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Basis Ref",
          "type": "string"
        },
        "material_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "rendition_kind": {
          "anyOf": [
            {
              "enum": [
                "text",
                "pages",
                "table",
                "index",
                "parse"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition Kind"
        },
        "rendition_no": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition No"
        },
        "rendition_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rendition Sha256"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version_no": {
          "minimum": 1,
          "title": "Version No",
          "type": "integer"
        }
      },
      "required": [
        "material_id",
        "version_no",
        "sha256",
        "basis",
        "basis_ref"
      ],
      "title": "GrantItemIn",
      "type": "object"
    },
